# llamator-mcp-server/tests/.env.test
# Timeouts (seconds)
LLAMATOR_MCP_TEST_HTTP_TIMEOUT_S=10
LLAMATOR_MCP_TEST_READY_TIMEOUT_S=3
LLAMATOR_MCP_TEST_READY_INTERVAL_S=0.25

# MCP
LLAMATOR_MCP_TEST_MCP_PROTOCOL_VERSION=2025-03-26

# Test run request defaults
LLAMATOR_MCP_TEST_PRESET_NAME=owasp:llm07
LLAMATOR_MCP_TEST_NUM_THREADS=1

# Tested model config for request payload
# Use the same TGI instance for tested/attack/judge.
# IMPORTANT: this base_url must be reachable from the worker container, hence "tgi:80" (docker compose network).
LLAMATOR_MCP_TEST_TESTED_KIND=openai
LLAMATOR_MCP_TEST_TESTED_BASE_URL=http://tgi:80/v1
LLAMATOR_MCP_TEST_TESTED_MODEL=tgi
LLAMATOR_MCP_TEST_TESTED_API_KEY=