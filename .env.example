# Redis
LLAMATOR_MCP_REDIS_DSN=redis://redis:6379/0

# Storage for LLAMATOR artifacts (logs/reports/csv)
LLAMATOR_MCP_ARTIFACTS_ROOT=/data/artifacts

# Optional API auth for HTTP/MCP endpoints (empty = disabled)
LLAMATOR_MCP_API_KEY=

# Default auxiliary LLM (for attack/judge when not provided by user)
LLAMATOR_MCP_AUX_OPENAI_BASE_URL=http://tgi:80/v1
LLAMATOR_MCP_AUX_OPENAI_MODEL=tgi
LLAMATOR_MCP_AUX_OPENAI_API_KEY=dummy

# Logging
LLAMATOR_MCP_LOG_LEVEL=INFO

# TGI model selection
AUX_LLM_MODEL_ID=microsoft/Phi-3-mini-4k-instruct
AUX_LLM_MAX_INPUT_LEN=2048
AUX_LLM_MAX_TOTAL_TOKENS=4096